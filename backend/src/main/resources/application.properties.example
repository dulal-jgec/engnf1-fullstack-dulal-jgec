spring.application.name=triagesync-backend

# Database Config (PostgreSQL) - Update with your local credentials
spring.datasource.url=jdbc:postgresql://localhost:5432/triagesync
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate Config
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

# Jackson (Time format for API)
spring.jackson.time-zone=UTC
spring.jackson.date-format=yyyy-MM-dd'T'HH:mm:ss.SSS'Z'

# JWT Config (Must be at least 256-bit / 32 bytes)
jwt.secret=YOUR_SUPER_SECRET_JWT_KEY_PLACEHOLDER_1234567890
jwt.expiration=86400000